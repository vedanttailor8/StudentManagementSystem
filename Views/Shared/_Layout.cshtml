
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StudentHub</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/StudentManagementSystem.styles.css"
          asp-append-version="true" />
</head>

<body>
    <div class="app-shell">

        <aside class="sidebar">
            <a asp-controller="Home" asp-action="Index"
               class="brand">
                <span class="brand-icon">S</span>
                <span>
                    <strong>StudentHub</strong>
                    <small>MANAGEMENT PORTAL</small>
                </span>
            </a>

            <div class="nav-heading">WORKSPACE</div>

            <nav class="side-nav">
                <a asp-controller="Home" asp-action="Index"
                   class="side-link">
                    <span class="nav-icon">▦</span>
                    Dashboard
                </a>

                <a asp-controller="Students" asp-action="Index"
                   class="side-link">
                    <span class="nav-icon">♙</span>
                    Students
                </a>

                <a asp-controller="Students" asp-action="Create"
                   class="side-link">
                    <span class="nav-icon">＋</span>
                    Add Student
                </a>

                <a asp-controller="Home" asp-action="About"
                   class="side-link">
                    <span class="nav-icon">ⓘ</span>
                    About
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-profile">
                    <div class="profile-avatar">SM</div>
                    <div>
                        <strong>Administrator</strong>
                        <small>Student Portal</small>
                    </div>
                </div>
            </div>
        </aside>

        <main class="main-area">

            <header class="topbar">
                <div>
                    <div class="topbar-label">
                        STUDENT MANAGEMENT
                    </div>

                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="topbar-right">
                    <span class="system-status">
                        <span class="status-dot"></span>
                        System Online
                    </span>

                    <div class="topbar-avatar">A</div>
                </div>
            </header>

            <section class="page-content">
                @RenderBody()
            </section>

            <footer class="app-footer">
                <span>StudentHub © @DateTime.Now.Year</span>
                <span>Student Management System</span>
            </footer>

        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
