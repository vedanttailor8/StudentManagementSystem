
@{
    ViewData["Title"] = "About";
}

<div class="welcome-banner">
    <div>
        <span class="eyebrow">ABOUT THE PLATFORM</span>
        <h2>StudentHub</h2>
        <p>A modern way to manage student information.</p>
    </div>
</div>

<div class="section-heading">
    <div>
        <h3>About StudentHub</h3>
        <p>One place for student records and academic details.</p>
    </div>
</div>

<div class="about-grid">
    <div class="stat-card">
        <span class="stat-icon blue-icon">♙</span>
        <h3>Student Records</h3>
        <p>Create, search, update and view student information.</p>
    </div>

    <div class="stat-card">
        <span class="stat-icon purple-icon">▤</span>
        <h3>Academic Information</h3>
        <p>Organize courses, enrollment numbers and semesters.</p>
    </div>

    <div class="stat-card">
        <span class="stat-icon green-icon">✓</span>
        <h3>Centralized Management</h3>
        <p>Keep student information organized in a database-backed system.</p>
    </div>
</div>

<div class="card about-tech-card">
    <div class="card-body">
        <h3>Technology Stack</h3>
        <p>ASP.NET Core MVC · C# · Entity Framework Core · MySQL</p>
        <a asp-controller="Home" asp-action="Index"
           class="btn btn-primary">Back to Dashboard</a>
    </div>
</div>
